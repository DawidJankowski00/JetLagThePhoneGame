<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TransitGames.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:TransitGames.App.Pages"
    xmlns:res="clr-namespace:TransitGames.UI.Resources;assembly=TransitGames.UI"
    Title="{x:Static res:UiStrings.AppTitle}">

    <TabBar>
        <ShellContent Title="{x:Static res:UiStrings.TabStart}" Icon="tab_games.png"
                      ContentTemplate="{DataTemplate pages:StartPage}" Route="start" />
        <ShellContent Title="{x:Static res:UiStrings.TabHistory}" Icon="tab_history.png"
                      ContentTemplate="{DataTemplate pages:HistoryPage}" Route="history" />
        <ShellContent Title="{x:Static res:UiStrings.TabTracks}" Icon="tab_tracks.png"
                      ContentTemplate="{DataTemplate pages:TracksPage}" Route="tracks" />
        <ShellContent Title="{x:Static res:UiStrings.TabSettings}" Icon="tab_settings.png"
                      ContentTemplate="{DataTemplate pages:SettingsPage}" Route="settings" />
    </TabBar>

</Shell>

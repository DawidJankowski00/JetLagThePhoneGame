<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TransitGames.App.ViewModels"
             xmlns:games="clr-namespace:TransitGames.Core.Games;assembly=TransitGames.Core"
             xmlns:res="clr-namespace:TransitGames.UI.Resources;assembly=TransitGames.UI"
             x:Class="TransitGames.App.Pages.HistoryDetailsPage"
             x:DataType="vm:HistoryDetailsViewModel"
             Title="{Binding Title}"
             Style="{StaticResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="16,12" Spacing="12">
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                        <Label Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource Caption}" FontAttributes="Bold" />
                    </Grid>
                    <Label Text="{Binding ResultHeadline}" IsVisible="{Binding HasResult}" FontSize="20" FontAttributes="Bold" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ResultLines}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="games:GameResultLine">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Label}" FontAttributes="Bold" />
                                    <Label Text="{Binding Value}" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" IsVisible="{Binding HasTrack}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="{x:Static res:UiStrings.HistoryTrack}" FontAttributes="Bold" />
                        <Label Text="{Binding TrackText}" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="{x:Static res:UiStrings.TrackPreview}" Style="{StaticResource ToolButton}"
                            Command="{Binding ShowTrackCommand}" />
                </Grid>
            </Border>

            <Label Text="{x:Static res:UiStrings.HistoryTimeline}" Style="{StaticResource Headline}" FontSize="20" />
            <Label Text="{x:Static res:UiStrings.HistoryTimelineEmpty}" IsVisible="{Binding IsTimelineEmpty}" Style="{StaticResource Caption}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Timeline}" Spacing="0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:TimelineItem">
                        <Grid ColumnDefinitions="56,32,*" Padding="0,6" ColumnSpacing="4">
                            <VerticalStackLayout>
                                <Label Text="{Binding Time}" FontAttributes="Bold" />
                                <Label Text="{Binding Offset}" Style="{StaticResource Caption}" FontSize="11" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding Icon}" FontSize="18" HorizontalOptions="Center" />
                            <VerticalStackLayout Grid.Column="2">
                                <Label Text="{Binding Title}" />
                                <Label Text="{Binding Details}" IsVisible="{Binding HasDetails}" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button Text="{x:Static res:UiStrings.HistoryResume}" Style="{StaticResource BigButton}"
                    Command="{Binding ResumeCommand}" IsVisible="{Binding CanResume}" />
            <Button Text="{x:Static res:UiStrings.HistoryFinish}" Style="{StaticResource BigSecondaryButton}"
                    Command="{Binding FinishCommand}" IsVisible="{Binding CanFinish}" />
            <Button Text="{x:Static res:UiStrings.HistoryDelete}" Style="{StaticResource BigSecondaryButton}"
                    Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

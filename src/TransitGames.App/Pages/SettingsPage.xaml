<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TransitGames.App.ViewModels"
             xmlns:res="clr-namespace:TransitGames.UI.Resources;assembly=TransitGames.UI"
             x:Class="TransitGames.App.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{x:Static res:UiStrings.SettingsTitle}"
             Style="{StaticResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{x:Static res:UiStrings.SettingsLanguage}" FontAttributes="Bold" />
                    <Picker ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{x:Static res:UiStrings.SettingsTheme}" FontAttributes="Bold" />
                    <Picker ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

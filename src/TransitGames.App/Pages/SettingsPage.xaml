<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TransitGames.App.ViewModels"
             xmlns:res="clr-namespace:TransitGames.UI.Resources;assembly=TransitGames.UI"
             x:Class="TransitGames.App.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{x:Static res:UiStrings.SettingsTitle}"
             Style="{StaticResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{x:Static res:UiStrings.SettingsLanguage}" FontAttributes="Bold" />
                    <Picker ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{x:Static res:UiStrings.SettingsTheme}" FontAttributes="Bold" />
                    <Picker ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{x:Static res:UiStrings.SettingsOnline}" FontAttributes="Bold" />
                    <Label Text="{x:Static res:UiStrings.SettingsServerUrl}" Style="{StaticResource Caption}" />
                    <Entry Text="{Binding ServerUrl}" Placeholder="{x:Static res:UiStrings.SettingsServerUrlPlaceholder}"
                           Keyboard="Url" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                    <Label Text="{x:Static res:UiStrings.SettingsPlayerName}" Style="{StaticResource Caption}" />
                    <Entry Text="{Binding PlayerName}" MaxLength="40" />
                    <Button Text="{x:Static res:UiStrings.SettingsTestConnection}" Command="{Binding TestConnectionCommand}"
                            Style="{StaticResource ToolButton}" HorizontalOptions="Start" />
                    <Label Text="{Binding ConnectionResult}" IsVisible="{Binding HasConnectionResult}" />
                    <Label Text="{x:Static res:UiStrings.SettingsOnlineHint}" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{x:Static res:UiStrings.SettingsTracking}" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{x:Static res:UiStrings.SettingsAutoRecord}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding AutoRecord}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="{x:Static res:UiStrings.SettingsBatterySaver}" />
                            <Label Text="{x:Static res:UiStrings.SettingsBatterySaverHint}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding BatterySaver}" VerticalOptions="Center" />
                    </Grid>
                    <VerticalStackLayout IsEnabled="{Binding CustomTracking}" Spacing="2">
                        <Label Text="{x:Static res:UiStrings.SettingsInterval}" Style="{StaticResource Caption}" />
                        <Picker ItemsSource="{Binding Intervals}" SelectedItem="{Binding SelectedInterval}" />
                        <Label Text="{x:Static res:UiStrings.SettingsMinDistance}" Style="{StaticResource Caption}" />
                        <Picker ItemsSource="{Binding MinDistances}" SelectedItem="{Binding SelectedMinDistance}" />
                        <Label Text="{x:Static res:UiStrings.SettingsMaxAccuracy}" Style="{StaticResource Caption}" />
                        <Picker ItemsSource="{Binding MaxAccuracies}" SelectedItem="{Binding SelectedMaxAccuracy}" />
                    </VerticalStackLayout>
                    <Label Text="{x:Static res:UiStrings.SettingsTrackingHint}" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

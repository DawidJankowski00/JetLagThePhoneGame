<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TransitGames.App.ViewModels"
             xmlns:res="clr-namespace:TransitGames.UI.Resources;assembly=TransitGames.UI"
             x:Class="TransitGames.App.Pages.StartPage"
             x:DataType="vm:StartViewModel"
             Title="{x:Static res:UiStrings.AppTitle}"
             Style="{StaticResource PageBackground}">
    <CollectionView ItemsSource="{Binding Games}" SelectionMode="None" Margin="16,0">
        <CollectionView.Header>
            <VerticalStackLayout Spacing="4" Padding="0,16,0,8">
                <Label Text="{x:Static res:UiStrings.StartTitle}" Style="{StaticResource Headline}" />
                <Label Text="{x:Static res:UiStrings.StartSubtitle}" Style="{StaticResource Caption}" />
                <Button Text="{Binding ResumeText}" IsVisible="{Binding HasResumableSession}"
                        Command="{Binding ResumeCommand}" Style="{StaticResource BigButton}" Margin="0,12,0,0" />
            </VerticalStackLayout>
        </CollectionView.Header>
        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:GameCard">
                <Border Style="{StaticResource Card}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectGameCommand, Source={RelativeSource AncestorType={x:Type vm:StartViewModel}}, x:DataType=vm:StartViewModel}"
                                              CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Label Text="{Binding Icon}" FontSize="40" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="{Binding DisplayName}" FontSize="20" FontAttributes="Bold" />
                            <Label Text="{Binding Description}" Style="{StaticResource Caption}" />
                            <Label Text="{Binding MinPlayersText}" FontSize="12" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TransitGames.App.ViewModels"
             xmlns:controls="clr-namespace:TransitGames.UI.Controls;assembly=TransitGames.UI"
             xmlns:res="clr-namespace:TransitGames.UI.Resources;assembly=TransitGames.UI"
             x:Class="TransitGames.App.Pages.TrackPreviewPage"
             x:DataType="vm:TrackPreviewViewModel"
             Title="{Binding Title}"
             Style="{StaticResource PageBackground}">
    <Grid RowDefinitions="*,Auto">
        <controls:GameMapView Area="{Binding Area}" Track="{Binding Lines}" Waypoints="{Binding Waypoints}" OwnLocation="{Binding Position}" />

        <VerticalStackLayout Grid.Row="1" Padding="16,8,16,12" Spacing="4">
            <Label Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Text="{Binding PlayText}" Command="{Binding TogglePlayCommand}" Style="{StaticResource ToolButton}"
                        WidthRequest="56" FontSize="20" />
                <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Progress}" VerticalOptions="Center" />
            </Grid>
            <Label Text="{Binding TimeText}" HorizontalOptions="Center" FontFamily="monospace" FontSize="16" />
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" IsVisible="{Binding HasEvents}">
                <Button Text="{x:Static res:UiStrings.TrackPreviousEvent}" Command="{Binding PreviousEventCommand}"
                        Style="{StaticResource ToolButton}" />
                <Label Grid.Column="1" Text="{Binding EventText}" VerticalOptions="Center" HorizontalTextAlignment="Center"
                       LineBreakMode="TailTruncation" MaxLines="2" />
                <Button Grid.Column="2" Text="{x:Static res:UiStrings.TrackNextEvent}" Command="{Binding NextEventCommand}"
                        Style="{StaticResource ToolButton}" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>

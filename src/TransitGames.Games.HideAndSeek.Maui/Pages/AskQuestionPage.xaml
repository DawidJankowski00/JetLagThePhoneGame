<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TransitGames.Games.HideAndSeek.Maui.ViewModels"
             xmlns:controls="clr-namespace:TransitGames.UI.Controls;assembly=TransitGames.UI"
             xmlns:res="clr-namespace:TransitGames.Games.HideAndSeek.Resources;assembly=TransitGames.Games.HideAndSeek"
             x:Class="TransitGames.Games.HideAndSeek.Maui.Pages.AskQuestionPage"
             x:DataType="vm:AskQuestionViewModel"
             Title="{x:Static res:HideAndSeekStrings.AskTitle}"
             Style="{StaticResource PageBackground}">
    <Grid RowDefinitions="2*,3*,Auto">
        <controls:GameMapView x:Name="Map" Area="{Binding Area}" OwnLocation="{Binding Location}" Waypoints="{Binding MapMarks}"
                              TapCommand="{Binding MapTappedCommand}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,8" Spacing="8">
                <FlexLayout BindableLayout.ItemsSource="{Binding Types}" Wrap="Wrap" JustifyContent="Start">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:QuestionTypeChoice">
                            <Button Text="{Binding Name}" Margin="0,0,6,6" Padding="12,0" HeightRequest="40" FontSize="14"
                                    Command="{Binding SelectTypeCommand, Source={RelativeSource AncestorType={x:Type vm:AskQuestionViewModel}}, x:DataType=vm:AskQuestionViewModel}"
                                    CommandParameter="{Binding .}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="False">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
                                        <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
                <Label Text="{Binding RuleText}" Style="{StaticResource Caption}" FontSize="12" />

                <VerticalStackLayout IsVisible="{Binding HasRadius}" Spacing="2">
                    <Label Text="{x:Static res:HideAndSeekStrings.AskRadius}" Style="{StaticResource Caption}" />
                    <Picker ItemsSource="{Binding Radii}" SelectedItem="{Binding SelectedRadius}" />
                </VerticalStackLayout>
                <VerticalStackLayout IsVisible="{Binding HasCategory}" Spacing="2">
                    <Label Text="{x:Static res:HideAndSeekStrings.AskCategory}" Style="{StaticResource Caption}" />
                    <Picker ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" />
                </VerticalStackLayout>
                <VerticalStackLayout IsVisible="{Binding IsThermometer}" Spacing="4">
                    <Label Text="{Binding ThermometerText}" />
                    <Button Text="{x:Static res:HideAndSeekStrings.ThermometerSetStart}" Style="{StaticResource ToolButton}"
                            HorizontalOptions="Start" Command="{Binding SetThermometerStartCommand}" />
                </VerticalStackLayout>
                <VerticalStackLayout IsVisible="{Binding IsPhoto}" Spacing="2">
                    <Label Text="{x:Static res:HideAndSeekStrings.PhotoSubject}" Style="{StaticResource Caption}" />
                    <Entry Text="{Binding PhotoSubject}" Placeholder="{x:Static res:HideAndSeekStrings.PhotoSubjectPlaceholder}" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="{Binding LocationText}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="{x:Static res:HideAndSeekStrings.AskUseGps}" Style="{StaticResource ToolButton}"
                            Command="{Binding UseGpsCommand}" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Padding="16,4,16,16" Spacing="6">
            <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsBusy}">
                <ActivityIndicator IsRunning="{Binding IsBusy}" HeightRequest="20" WidthRequest="20" />
                <Label Text="{Binding BusyText}" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Button Text="{Binding ButtonText}" Style="{StaticResource BigButton}" Command="{Binding AskCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>

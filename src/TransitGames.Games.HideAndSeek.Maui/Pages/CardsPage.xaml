<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TransitGames.Games.HideAndSeek.Maui.ViewModels"
             xmlns:res="clr-namespace:TransitGames.Games.HideAndSeek.Resources;assembly=TransitGames.Games.HideAndSeek"
             x:Class="TransitGames.Games.HideAndSeek.Maui.Pages.CardsPage"
             x:DataType="vm:CardsViewModel"
             Title="{x:Static res:HideAndSeekStrings.CardsTitle}"
             Style="{StaticResource PageBackground}">
    <CollectionView ItemsSource="{Binding Hand}" SelectionMode="None" Margin="16,0">
        <CollectionView.Header>
            <VerticalStackLayout Spacing="8" Padding="0,12,0,8">
                <Label Text="{Binding DeckText}" Style="{StaticResource Caption}" />
                <Button Text="{Binding PendingText}" IsVisible="{Binding HasPendingDraws}" Style="{StaticResource BigButton}"
                        Command="{Binding ChoosePendingCommand}" />
                <Label Text="{x:Static res:HideAndSeekStrings.HandEmpty}" IsVisible="{Binding IsHandEmpty}" Style="{StaticResource Caption}" />
            </VerticalStackLayout>
        </CollectionView.Header>
        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:CardItem">
                <Border Style="{StaticResource Card}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PlayCommand, Source={RelativeSource AncestorType={x:Type vm:CardsViewModel}}, x:DataType=vm:CardsViewModel}"
                                              CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="17" />
                            <Label Grid.Column="1" Text="{Binding KindText}" Style="{StaticResource Caption}" FontSize="12" />
                        </Grid>
                        <Label Text="{Binding Text}" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>

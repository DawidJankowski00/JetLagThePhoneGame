<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TransitGames.Games.HideAndSeek.Maui.ViewModels"
             xmlns:controls="clr-namespace:TransitGames.UI.Controls;assembly=TransitGames.UI"
             xmlns:ui="clr-namespace:TransitGames.UI.Resources;assembly=TransitGames.UI"
             xmlns:res="clr-namespace:TransitGames.Games.HideAndSeek.Resources;assembly=TransitGames.Games.HideAndSeek"
             x:Class="TransitGames.Games.HideAndSeek.Maui.Pages.HideAndSeekGamePage"
             x:DataType="vm:HideAndSeekGameViewModel"
             Shell.NavBarIsVisible="False"
             Style="{StaticResource PageBackground}">
    <Grid RowDefinitions="Auto,*,Auto">
        <controls:SessionHeaderView BindingContext="{Binding Header}" />

        <VerticalStackLayout Grid.Row="1" Padding="24" Spacing="12" VerticalOptions="Center">
            <Label Text="{x:Static res:HideAndSeekStrings.RoleSeekerDescription}" IsVisible="{Binding IsSeeker}"
                   HorizontalTextAlignment="Center" FontSize="18" />
            <Label Text="{x:Static res:HideAndSeekStrings.RoleHiderDescription}" IsVisible="{Binding IsHider}"
                   HorizontalTextAlignment="Center" FontSize="18" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2" Padding="16" Spacing="8">
            <Button Text="{x:Static ui:UiStrings.FinishGame}" Style="{StaticResource BigButton}"
                    Command="{Binding Header.FinishCommand}" />
            <Button Text="{x:Static ui:UiStrings.LeaveGame}" Style="{StaticResource BigSecondaryButton}"
                    Command="{Binding Header.LeaveCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TransitGames.Games.HideAndSeek.Maui.ViewModels"
             xmlns:controls="clr-namespace:TransitGames.UI.Controls;assembly=TransitGames.UI"
             xmlns:ui="clr-namespace:TransitGames.UI.Resources;assembly=TransitGames.UI"
             xmlns:res="clr-namespace:TransitGames.Games.HideAndSeek.Resources;assembly=TransitGames.Games.HideAndSeek"
             x:Class="TransitGames.Games.HideAndSeek.Maui.Pages.HideAndSeekGamePage"
             x:DataType="vm:HideAndSeekGameViewModel"
             Shell.NavBarIsVisible="False"
             Style="{StaticResource PageBackground}">
    <Grid RowDefinitions="Auto,*,Auto">
        <controls:SessionHeaderView BindingContext="{Binding Header}" />

        <controls:GameMapView Grid.Row="1" Area="{Binding Header.Area}" Stations="{Binding Header.Stations}"
                              OwnLocation="{Binding Header.OwnLocation}" />

        <VerticalStackLayout Grid.Row="2" Padding="16,10" Spacing="8">
            <Label Text="{x:Static res:HideAndSeekStrings.RoleSeekerDescription}" IsVisible="{Binding IsSeeker}" Style="{StaticResource Caption}" />
            <Label Text="{x:Static res:HideAndSeekStrings.RoleHiderDescription}" IsVisible="{Binding IsHider}" Style="{StaticResource Caption}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="{x:Static ui:UiStrings.LeaveGame}" Style="{StaticResource BigSecondaryButton}" FontSize="15" Padding="4,0"
                        Command="{Binding Header.LeaveCommand}" />
                <Button Grid.Column="1" Text="{x:Static ui:UiStrings.FinishGame}" Style="{StaticResource BigButton}" FontSize="15" Padding="4,0"
                        Command="{Binding Header.FinishCommand}" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>

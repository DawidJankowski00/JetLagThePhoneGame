<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TransitGames.Games.Tag.Maui.ViewModels"
             xmlns:controls="clr-namespace:TransitGames.UI.Controls;assembly=TransitGames.UI"
             xmlns:res="clr-namespace:TransitGames.Games.Tag.Resources;assembly=TransitGames.Games.Tag"
             x:Class="TransitGames.Games.Tag.Maui.Pages.MapPickPage"
             x:DataType="vm:MapPickViewModel"
             Title="{x:Static res:TagStrings.PickTitle}"
             Style="{StaticResource PageBackground}">
    <Grid RowDefinitions="Auto,*,Auto">
        <Label Text="{Binding Hint}" Style="{StaticResource HintBanner}" />

        <controls:GameMapView x:Name="Map" Grid.Row="1" Area="{Binding Area}" Stations="{Binding Stations}"
                              TapCommand="{Binding MapTappedCommand}" />

        <VerticalStackLayout Grid.Row="2" Padding="16,8,16,12" Spacing="8">
            <Label Text="{Binding PickedText}" FontAttributes="Bold" />
            <Button Text="{x:Static res:TagStrings.PickMyPosition}" Style="{StaticResource BigSecondaryButton}" FontSize="15"
                    Command="{Binding UseMyPositionCommand}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="{x:Static res:TagStrings.PickCancel}" Style="{StaticResource BigSecondaryButton}" FontSize="15" Padding="4,0"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="1" Text="{x:Static res:TagStrings.PickConfirm}" Style="{StaticResource BigButton}" FontSize="15" Padding="4,0"
                        Command="{Binding ConfirmCommand}" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TransitGames.Games.Tag.Maui.ViewModels"
             xmlns:controls="clr-namespace:TransitGames.UI.Controls;assembly=TransitGames.UI"
             xmlns:res="clr-namespace:TransitGames.Games.Tag.Resources;assembly=TransitGames.Games.Tag"
             x:Class="TransitGames.Games.Tag.Maui.Pages.TagGamePage"
             x:DataType="vm:TagGameViewModel"
             Shell.NavBarIsVisible="False"
             Style="{StaticResource PageBackground}">
    <Grid RowDefinitions="Auto,*,Auto">
        <controls:SessionHeaderView BindingContext="{Binding Header}" />

        <Grid Grid.Row="1">
            <controls:GameMapView x:Name="Map" Area="{Binding Header.Area}"
                                  OwnLocation="{Binding Header.OwnLocation}" Players="{Binding Header.Players}" />
            <!-- Legend: what the colours mean. -->
            <Border VerticalOptions="Start" HorizontalOptions="Start" Margin="8" Padding="8,4"
                    BackgroundColor="{AppThemeBinding Light=#E6FFFFFF, Dark=#E6212121}" StrokeThickness="0"
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="2">
                    <HorizontalStackLayout Spacing="6">
                        <BoxView WidthRequest="12" HeightRequest="12" Color="{StaticResource MapFinalTarget}" CornerRadius="6" />
                        <Label Text="{x:Static res:TagStrings.LegendOwnDestination}" FontSize="11" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="6">
                        <BoxView WidthRequest="12" HeightRequest="12" Color="{StaticResource MapTarget}" CornerRadius="6" />
                        <Label Text="{x:Static res:TagStrings.LegendDestination}" FontSize="11" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="6">
                        <BoxView WidthRequest="12" HeightRequest="12" Color="{StaticResource MapOpponent}" CornerRadius="6" />
                        <Label Text="{x:Static res:TagStrings.LegendRunner}" FontSize="11" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="6">
                        <BoxView WidthRequest="12" HeightRequest="12" Color="{StaticResource MapTeammate}" CornerRadius="6" />
                        <Label Text="{x:Static res:TagStrings.LegendStart}" FontSize="11" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <VerticalStackLayout Grid.Row="2" Padding="16,8,16,12" Spacing="6">
            <Label Text="{Binding PhaseTitle}" FontSize="18" FontAttributes="Bold" />
            <Label Text="{Binding PhaseDetail}" Style="{StaticResource Caption}" />
            <Label Text="{Binding NoticeText}" IsVisible="{Binding HasNotice}" Style="{StaticResource HintBanner}" Margin="-16,0" />

            <!-- Coins, ride, challenge, curses, players: capped so the map stays visible. -->
            <ScrollView MaximumHeightRequest="190">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Info}" Spacing="4">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:InfoRow">
                            <Grid ColumnDefinitions="28,*" ColumnSpacing="4">
                                <Label Text="{Binding Icon}" FontSize="16" VerticalOptions="Start" />
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="14" />
                                    <Label Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="12" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>

            <FlexLayout BindableLayout.ItemsSource="{Binding Actions}" Wrap="Wrap" JustifyContent="SpaceBetween">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:TagAction">
                        <Grid FlexLayout.Basis="49%" Margin="0,3">
                            <Button Text="{Binding Text}" Command="{Binding Command}" IsEnabled="{Binding IsEnabled}" IsVisible="{Binding IsPrimary}"
                                    Style="{StaticResource BigButton}" FontSize="14" Padding="4,0" />
                            <Button Text="{Binding Text}" Command="{Binding Command}" IsEnabled="{Binding IsEnabled}" IsVisible="{Binding IsSecondary}"
                                    Style="{StaticResource BigSecondaryButton}" FontSize="14" Padding="4,0" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="{x:Static res:TagStrings.ButtonLeave}" Style="{StaticResource BigSecondaryButton}" FontSize="14" Padding="2,0"
                        Command="{Binding Header.LeaveCommand}" />
                <Button Grid.Column="1" Text="{x:Static res:TagStrings.ButtonFinish}" Style="{StaticResource BigSecondaryButton}" FontSize="14" Padding="2,0"
                        Command="{Binding Header.FinishCommand}" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>

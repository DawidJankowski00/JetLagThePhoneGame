<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TransitGames.Games.Tag.Maui.ViewModels"
             xmlns:controls="clr-namespace:TransitGames.UI.Controls;assembly=TransitGames.UI"
             xmlns:ui="clr-namespace:TransitGames.UI.Resources;assembly=TransitGames.UI"
             xmlns:res="clr-namespace:TransitGames.Games.Tag.Resources;assembly=TransitGames.Games.Tag"
             x:Class="TransitGames.Games.Tag.Maui.Pages.TagGamePage"
             x:DataType="vm:TagGameViewModel"
             Shell.NavBarIsVisible="False"
             Style="{StaticResource PageBackground}">
    <Grid RowDefinitions="Auto,*,Auto">
        <controls:SessionHeaderView BindingContext="{Binding Header}" />

        <controls:GameMapView Grid.Row="1" Area="{Binding Header.Area}" Stations="{Binding Header.Stations}" />

        <VerticalStackLayout Grid.Row="2" Padding="16,10" Spacing="8">
            <Label Text="{x:Static res:TagStrings.RoleChaserDescription}" IsVisible="{Binding IsChaser}" Style="{StaticResource Caption}" />
            <Label Text="{x:Static res:TagStrings.RoleRunnerDescription}" IsVisible="{Binding IsRunner}" Style="{StaticResource Caption}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="{x:Static ui:UiStrings.LeaveGame}" Style="{StaticResource BigSecondaryButton}" FontSize="15" Padding="4,0"
                        Command="{Binding Header.LeaveCommand}" />
                <Button Grid.Column="1" Text="{x:Static ui:UiStrings.FinishGame}" Style="{StaticResource BigButton}" FontSize="15" Padding="4,0"
                        Command="{Binding Header.FinishCommand}" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>

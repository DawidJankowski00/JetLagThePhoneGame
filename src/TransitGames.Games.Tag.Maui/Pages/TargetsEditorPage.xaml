<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TransitGames.Games.Tag.Maui.ViewModels"
             xmlns:controls="clr-namespace:TransitGames.UI.Controls;assembly=TransitGames.UI"
             xmlns:res="clr-namespace:TransitGames.Games.Tag.Resources;assembly=TransitGames.Games.Tag"
             x:Class="TransitGames.Games.Tag.Maui.Pages.TargetsEditorPage"
             x:DataType="vm:TargetsEditorViewModel"
             Title="{x:Static res:TagStrings.EditorTitle}"
             Style="{StaticResource PageBackground}">
    <Grid RowDefinitions="Auto,*,Auto">
        <Label Text="{Binding ModeText}" Style="{StaticResource HintBanner}" />

        <controls:GameMapView x:Name="Map" Grid.Row="1" Area="{Binding Area}"
                              TapCommand="{Binding MapTappedCommand}" />

        <VerticalStackLayout Grid.Row="2" Padding="16,8,16,12" Spacing="8">
            <Label Text="{Binding SummaryText}" Style="{StaticResource Caption}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="{x:Static res:TagStrings.EditorToggleMode}" Style="{StaticResource BigSecondaryButton}" FontSize="15" Padding="4,0"
                        Command="{Binding ToggleModeCommand}" />
                <Button Grid.Column="1" Text="{x:Static res:TagStrings.EditorRemoveFinal}" Style="{StaticResource BigSecondaryButton}" FontSize="15" Padding="4,0"
                        Command="{Binding RemoveFinalCommand}" />
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="{x:Static res:TagStrings.EditorClear}" Style="{StaticResource BigSecondaryButton}" FontSize="15" Padding="4,0"
                        Command="{Binding ClearCommand}" />
                <Button Grid.Column="1" Text="{x:Static res:TagStrings.EditorDone}" Style="{StaticResource BigButton}" FontSize="15" Padding="4,0"
                        Command="{Binding DoneCommand}" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TransitGames.Games.Tag.Maui.ViewModels"
             xmlns:res="clr-namespace:TransitGames.Games.Tag.Resources;assembly=TransitGames.Games.Tag"
             x:Class="TransitGames.Games.Tag.Maui.Views.TagSettingsView"
             x:DataType="vm:TagSettingsViewModel">
    <VerticalStackLayout Spacing="12">
        <Label Text="{x:Static res:TagStrings.SettingsOnlineOnly}" Style="{StaticResource Caption}" />

        <Border Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="4">
                <Label Text="{x:Static res:TagStrings.SettingsGameDuration}" FontAttributes="Bold" />
                <Picker ItemsSource="{Binding GameDurations}" SelectedItem="{Binding SelectedGameDuration}" />
                <Label Text="{x:Static res:TagStrings.SettingsHeadStart}" FontAttributes="Bold" Margin="0,8,0,0" />
                <Picker ItemsSource="{Binding HeadStarts}" SelectedItem="{Binding SelectedHeadStart}" />
                <Label Text="{x:Static res:TagStrings.SettingsRevealInterval}" FontAttributes="Bold" Margin="0,8,0,0" />
                <Picker ItemsSource="{Binding RevealIntervals}" SelectedItem="{Binding SelectedRevealInterval}" />
                <Label Text="{x:Static res:TagStrings.SettingsCatchRadius}" FontAttributes="Bold" Margin="0,8,0,0" />
                <Picker ItemsSource="{Binding CatchRadii}" SelectedItem="{Binding SelectedCatchRadius}" />
                <Label Text="{x:Static res:TagStrings.SettingsCatchRadiusHint}" Style="{StaticResource Caption}" FontSize="12" />
                <Label Text="{x:Static res:TagStrings.SettingsNextRunner}" FontAttributes="Bold" Margin="0,8,0,0" />
                <Picker ItemsSource="{Binding NextRunnerModes}" SelectedItem="{Binding SelectedNextRunner}" />
            </VerticalStackLayout>
        </Border>

        <Border Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="4">
                <Label Text="{x:Static res:TagStrings.SettingsStartingCoins}" FontAttributes="Bold" />
                <Picker ItemsSource="{Binding Coins}" SelectedItem="{Binding SelectedStartingCoins}" />
                <Label Text="{x:Static res:TagStrings.SettingsTurnBonus}" FontAttributes="Bold" Margin="0,8,0,0" />
                <Picker ItemsSource="{Binding BonusModes}" SelectedItem="{Binding SelectedBonusMode}" />
                <Picker ItemsSource="{Binding BonusAmounts}" SelectedItem="{Binding SelectedTurnBonus}" IsVisible="{Binding IsFixedBonus}" />
                <Picker ItemsSource="{Binding Coins}" SelectedItem="{Binding SelectedTopUp}" IsVisible="{Binding IsTopUp}" />
                <Label Text="{x:Static res:TagStrings.SettingsTurnBonusHint}" Style="{StaticResource Caption}" FontSize="12" />
                <Label Text="{x:Static res:TagStrings.SettingsFareModel}" FontAttributes="Bold" Margin="0,8,0,0" />
                <Picker ItemsSource="{Binding FareModels}" SelectedItem="{Binding SelectedFareModel}" />
                <Label Text="{Binding FaresText}" Style="{StaticResource Caption}" FontSize="12" />
                <Button Text="{x:Static res:TagStrings.SettingsEditFares}" Style="{StaticResource ToolButton}" Command="{Binding EditFaresCommand}"
                        IsVisible="{Binding HasRates}" />
                <Label Text="{x:Static res:TagStrings.SettingsFaresHint}" Style="{StaticResource Caption}" FontSize="12" />
            </VerticalStackLayout>
        </Border>

        <Border Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="4">
                <Label Text="{x:Static res:TagStrings.SettingsDestinations}" FontAttributes="Bold" />
                <Picker ItemsSource="{Binding DestinationModes}" SelectedItem="{Binding SelectedDestinationMode}" />
                <VerticalStackLayout IsVisible="{Binding IsRandomDestinations}" Spacing="4">
                    <Label Text="{x:Static res:TagStrings.SettingsMinDistance}" />
                    <Picker ItemsSource="{Binding MinDistances}" SelectedItem="{Binding SelectedMinDistance}" />
                    <Label Text="{x:Static res:TagStrings.SettingsMaxDistance}" />
                    <Picker ItemsSource="{Binding MaxDistances}" SelectedItem="{Binding SelectedMaxDistance}" />
                    <Label Text="{x:Static res:TagStrings.SettingsSpacing}" />
                    <Picker ItemsSource="{Binding Spacings}" SelectedItem="{Binding SelectedSpacing}" />
                </VerticalStackLayout>
                <Label Text="{x:Static res:TagStrings.SettingsDestinationRadius}" FontAttributes="Bold" Margin="0,8,0,0" />
                <Picker ItemsSource="{Binding DestinationRadii}" SelectedItem="{Binding SelectedDestinationRadius}" />
                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="{x:Static res:TagStrings.SettingsDestinationsVisible}" />
                        <Label Text="{x:Static res:TagStrings.SettingsDestinationsVisibleHint}" Style="{StaticResource Caption}" FontSize="12" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding DestinationsVisible}" VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Border Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="4">
                <Label Text="{x:Static res:TagStrings.SettingsDeck}" FontAttributes="Bold" />
                <Label Text="{Binding DeckText}" Style="{StaticResource Caption}" />
                <Label Text="{x:Static res:TagStrings.SettingsDrawCooldown}" FontAttributes="Bold" Margin="0,8,0,0" />
                <Picker ItemsSource="{Binding DrawCooldowns}" SelectedItem="{Binding SelectedDrawCooldown}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Text="{x:Static res:TagStrings.SettingsDeckLoad}" Style="{StaticResource ToolButton}" Command="{Binding LoadDeckCommand}" />
                    <Button Grid.Column="1" Text="{x:Static res:TagStrings.SettingsDeckReset}" Style="{StaticResource ToolButton}" Command="{Binding ResetDeckCommand}" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentView>

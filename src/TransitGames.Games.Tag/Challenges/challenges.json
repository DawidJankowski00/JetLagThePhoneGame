      "text": { "pl": "Ułóżcie czterowiersz o tym miejscu i nagrajcie go.", "en": "Make up a four-line rhyme about this place and record it." } },
    { "id": "oldest", "reward": 3,
      "title": { "pl": "Najstarszy ślad", "en": "Oldest trace" },

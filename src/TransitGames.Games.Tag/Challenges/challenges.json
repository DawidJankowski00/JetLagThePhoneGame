    { "id": "colors", "reward": 2,
      "title": { "pl": "Pięć kolorów", "en": "Five colours" },
      "text": { "pl": "Zróbcie pięć zdjęć przedmiotów w pięciu różnych kolorach, nie ruszając się stąd.", "en": "Take five photos of objects in five different colours without leaving this spot." } },
    { "id": "rhyme", "reward": 3,

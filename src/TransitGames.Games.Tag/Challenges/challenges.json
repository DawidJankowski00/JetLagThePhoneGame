    { "id": "timetable", "reward": 2,
      "title": { "pl": "Rozkład jazdy", "en": "Timetable" },
      "text": { "pl": "Znajdźcie najbliższy przystanek i sfotografujcie jego rozkład jazdy.", "en": "Find the nearest stop and take a photo of its timetable." } },

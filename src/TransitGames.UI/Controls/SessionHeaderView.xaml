<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TransitGames.UI.ViewModels"
             xmlns:res="clr-namespace:TransitGames.UI.Resources"
             x:Class="TransitGames.UI.Controls.SessionHeaderView"
             x:DataType="vm:ActiveSessionViewModel">
    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" Padding="16,10" ColumnSpacing="12" RowSpacing="6"
          BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
        <VerticalStackLayout Spacing="2">
            <Label Text="{Binding GameName}" FontSize="18" FontAttributes="Bold" TextColor="White" />
            <Label TextColor="White" FontSize="14">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{x:Static res:UiStrings.RoleLabel}" />
                        <Span Text=": " />
                        <Span Text="{Binding RoleName}" FontAttributes="Bold" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center">
            <HorizontalStackLayout Spacing="8" HorizontalOptions="End">
                <Label Text="{x:Static res:UiStrings.RecordingIndicator}" IsVisible="{Binding IsRecording}"
                       TextColor="#FFCDD2" FontSize="12" FontAttributes="Bold" />
                <Label Text="{x:Static res:UiStrings.ElapsedLabel}" TextColor="White" FontSize="12" />
            </HorizontalStackLayout>
            <Label Text="{Binding ElapsedText}" TextColor="White" FontSize="22" FontAttributes="Bold"
                   FontFamily="monospace" HorizontalOptions="End" />
        </VerticalStackLayout>

        <!-- Online games: connection, game code (tap to share) and what the own position reveals. -->
        <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="2" IsVisible="{Binding IsOnlineGame}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Text="{Binding ConnectionText}" TextColor="White" FontSize="13" FontAttributes="Bold"
                       VerticalOptions="Center" LineBreakMode="TailTruncation" />
                <Border Grid.Column="1" Padding="10,4" StrokeThickness="1" Stroke="White" BackgroundColor="Transparent"
                        StrokeShape="RoundRectangle 12" SemanticProperties.Description="{x:Static res:UiStrings.OnlineShareCode}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShareCodeCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding CodeText}" TextColor="White" FontSize="13" FontAttributes="Bold" FontFamily="monospace" />
                </Border>
            </Grid>
            <Label Text="{Binding SharingText}" TextColor="White" FontSize="12" />
        </VerticalStackLayout>
    </Grid>
</ContentView>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(MauiTargetFrameworks)</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.Maui" />
    <PackageReference Include="Mapsui.Maui" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TransitGames.Core\TransitGames.Core.csproj" />
    <ProjectReference Include="..\TransitGames.Geo\TransitGames.Geo.csproj" />
    <ProjectReference Include="..\TransitGames.Tracking\TransitGames.Tracking.csproj" />
  </ItemGroup>

</Project>
